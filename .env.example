# Copia este archivo como .env y ajusta los valores si lo necesitas.
# .env NO se sube a Git (está en .gitignore); este .env.example sí.
# Solo valores de desarrollo: nunca pongas aquí contraseñas reales.

POSTGRES_USER=suite
POSTGRES_PASSWORD=suite_dev
POSTGRES_DB=suite_flotas
POSTGRES_PORT=5432

# Cadena de conexión que usa el backend
DATABASE_URL=postgresql+psycopg://suite:suite_dev@127.0.0.1:5432/suite_flotas

# Clave para firmar los tokens de sesión (mínimo 32 caracteres). En tu .env pon una
# aleatoria:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres
